# ATS scanner settings. Copy this file to `.env` (same folder as pyproject.toml) and fill it in:
#     cp .env.example .env
# `.env` is git-ignored, so your keys are never committed. Check what loaded with:
#     .venv/bin/python -m ats env

# --- Gemini API key (required for the AI features) ---------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# Without a key the app still ranks resumes with local scoring, but AI review, JD profiling,
# semantic match, scanned-PDF OCR and resume suggestions are switched off.
GEMINI_API_KEY=

# Optional: several keys (comma separated). They are rotated when one hits its rate limit and the
# request budget scales with the number of keys. Use keys from DIFFERENT Google projects; keys
# from the same project share one quota. If set, these are used before GEMINI_API_KEY.
# GEMINI_API_KEYS=key1,key2,key3

# `GOOGLE_API_KEY` is also accepted as an alias for GEMINI_API_KEY.

# --- Optional tuning (defaults shown) ----------------------------------------------------------
# ATS_MODEL=gemini-3.1-flash-lite          # (alias: GEMINI_MODEL)
# ATS_EMBED_MODEL=gemini-embedding-001     # (alias: GEMINI_EMBED_MODEL)
# ATS_LLM_RPM=13                           # generateContent requests/min per key (free tier is 15)
# ATS_LLM_CONCURRENCY=4                    # parallel AI-review workers
# ATS_EMBED_TPM=22000                      # embedding tokens/min (free tier is ~30k)
# ATS_NO_WARM=1                            # don't compute embeddings in the background on server start
